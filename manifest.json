{
  "manifest_version": 3,
  "name": "PropertyOS LINE Importer",
  "version": "0.4.15",
  "description": "Import your LINE Official Account chat history into PropertyOS.",
  "minimum_chrome_version": "102",
  "host_permissions": ["https://chat.line.biz/*"],
  "externally_connectable": {
    "matches": [
      "https://app.propertyos.io/*",
      "https://*.propertyos.io/*",
      "https://app.propertyos.dev/*",
      "https://propertyos.in.th/*",
      "http://localhost/*"
    ]
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PropertyOS LINE Importer"
  },
  "key": ""
}
